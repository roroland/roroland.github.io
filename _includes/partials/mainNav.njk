{# ---------------------------------------------
   Navegación principal compartida.
   En la home usa anclas; fuera de la home vuelve a "/#...".
   --------------------------------------------- #}
{% set isHome = page.url == "/" %}
{% set homePath = "" if isHome else "/" %}
<nav class="mainNav" aria-label="Main navigation">
  <ul>
    <li><a href="{{ homePath }}#aboutIntro">About Me</a></li>
    <li><a href="{{ homePath }}#what">What I Do</a></li>
    <li><a href="{{ homePath }}#works">Recent Work</a></li>
    <li>
      <a href="/blog/"{% if page.url and "/blog/" in page.url %} aria-current="page"{% endif %}>Blog</a>
    </li>
    <li><a href="{{ homePath }}#contact">Contact</a></li>
  </ul>
</nav>
